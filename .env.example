# ============================================================================
# Integrasi backend PORA XV (lihat docs/backend/PRD-BACKEND-ADMIN.md §3.3)
# Salin file ini ke `.env` lalu sesuaikan. `.env` di-gitignore (URL per-mesin).
# Jika kosong, lapisan data jatuh ke default localhost di src/lib/api/config.ts.
# ============================================================================

# simpora2026 (Laravel/MySQL) — data olahraga, READ-ONLY langsung
VITE_SIMPORA_API_URL=http://localhost:8000/api/v1

# cms-media (NestJS/PostgreSQL) — konten media, READ + tulis publik
VITE_CMS_API_URL=http://localhost:3000/api/v1

# cms-media gateway — socket.io real-time (skor/klasemen/streaming/penonton)
VITE_CMS_WS_URL=http://localhost:3000
